{
  "name": "@return-integrity/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/handler.js",
  "scripts": {
    "build": "tsup src/handler.ts --format esm --platform node --target node22 --external @aws-sdk/* --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.876.0",
    "@aws-sdk/client-s3": "^3.876.0",
    "@aws-sdk/client-secrets-manager": "^3.876.0",
    "@aws-sdk/lib-dynamodb": "^3.876.0",
    "@aws-sdk/s3-presigned-post": "^3.876.0",
    "@aws-sdk/s3-request-presigner": "^3.876.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@return-integrity/domain": "0.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
